CROSSBORDER_APP_MODE=demo
PORT=8000
# Private-mode task and Agent state. Provider credentials are never stored here.
CROSSBORDER_STATE_DB=database/crossborder_state.db
# Demo sessions are isolated in memory and removed after this many seconds.
CROSSBORDER_DEMO_SESSION_TTL=3600
# Public deployments may configure a server-side OpenAI-compatible provider.
# AI_BASE_URL=https://provider.example/v1
# AI_API_KEY=
# AI_MODEL=
# AI_WIRE_API=responses
